# Copy to .env and adjust. Loaded by rag/config.py via python-dotenv.

# --- Postgres (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdb
DB_USER=rag
DB_PASSWORD=rag

# --- Embedding ---
# Supported out of the box: BAAI/bge-base-en-v1.5 (768), sentence-transformers/all-MiniLM-L6-v2 (384)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBED_BATCH_SIZE=64
# auto | cuda | mps | cpu   (auto = cuda if present, else mps on Apple Silicon, else cpu)
DEVICE=auto
# Inference precision, held constant across every run (embedding + reranker) so
# latency comparisons are apples-to-apples. fp16 | bf16 | fp32. Recorded per run
# in eval_runs.dtype. fp16 ~3.9x faster than fp32 here, top-10 ranking 99.7% equal.
TORCH_DTYPE=fp16

# --- Chunking defaults (override per-run without editing code) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
RRF_K=60
TOP_K=50
RERANK_MODEL=BAAI/bge-reranker-base

# --- Correctness rule for evaluation: exact_chunk | span_overlap | same_page ---
CORRECTNESS_RULE=span_overlap

# --- Generation. Provider is a seam; OpenAI is wired, Anthropic is reserved. ---
GENERATION_PROVIDER=openai
# Mid-tier, configurable. Must be a model your key can reach (see `GET /v1/models`).
GENERATION_MODEL=gpt-5.6-terra
# OPENAI_API_KEY is read from the environment; do not commit it.
OPENAI_API_KEY=sk-...
